{
  "version": "0.2",
  "language": "en-US",
  "allowCompoundWords": false,
  "globRoot": ".",
  "ignorePaths": [
    "**/.*.json",
    ".*ignore",
    "composer.lock",
    "node_modules/*",
    "package.json",
    "yarn.lock",
    ".yarnrc.yml",
    ".yarn/*",
    ".cspell/dictionary.txt"
  ],
  "ignoreRegExpList": [
    "^msgstr .*",
    "!!binary .*",
    "%[0-9][0-9A-F]",
    "\\Wi18n",
    "\\x{[0-9A-F]{4,5}}"
  ],
  "dictionaries": [
    "dictionary",
    "companies",
    "fonts",
    "html",
    "php",
    "softwareTerms"
  ],
  "dictionaryDefinitions": [
    {
      "name": "dictionary",
      "path": "./.cspell/dictionary.txt"
    }
  ],
  "flagWords": [
    "e-mail",
    "grey",
    "hte",
    "ist",
    "queuing",
    "writeable"
  ],
  "overrides": [
    {
      "filename": "**/{*.engine,*.inc,*.install,*.module,*.profile,*.theme}",
      "languageId": "php"
    }
  ]
}
