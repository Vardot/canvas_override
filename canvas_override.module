<?php

/**
 * @file
 * Lets site builders enable per-node Canvas layout editing on the full content
 * view mode for selected content types.
 */

use Drupal\Core\Entity\Display\EntityFormDisplayInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\NodeInterface;
use Drupal\node\NodeTypeInterface;

/**
 * The machine name of the component_tree field added to content types.
 */
const CANVAS_OVERRIDE_FIELD_NAME = 'field_canvas_layout';

/**
 * Implements hook_entity_view_alter().
 *
 * When a node has a per-node Canvas layout stored in field_canvas_layout,
 * this replaces whatever the ContentTemplate (or standard Drupal) rendered
 * with just the per-node canvas layout. This enables Layout Builder-style
 * overrides: specific nodes use their own layout while all other nodes fall
 * back to the shared ContentTemplate default.
 */
function canvas_override_entity_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display): void {
  if (!$entity instanceof NodeInterface) {
    return;
  }

  // Only act on the 'full' view mode.
  if (($build['#view_mode'] ?? NULL) !== 'full') {
    return;
  }

  // Only for bundles with canvas_override enabled.
  $node_type = \Drupal::entityTypeManager()->getStorage('node_type')->load($entity->bundle());
  if (!$node_type?->getThirdPartySetting('canvas_override', 'enabled', FALSE)) {
    return;
  }

  // Only act when the node has a non-empty per-node canvas layout.
  if (!$entity->hasField(CANVAS_OVERRIDE_FIELD_NAME) || $entity->get(CANVAS_OVERRIDE_FIELD_NAME)->isEmpty()) {
    return;
  }

  // Clear all rendered output: ContentTemplate output or standard field output.
  foreach (Element::children($build) as $key) {
    unset($build[$key]);
  }
  // Remove node.html.twig wrapper; canvas output is self-contained.
  unset($build['#theme']);

  // Render the per-node canvas layout as the complete page output.
  $build[CANVAS_OVERRIDE_FIELD_NAME] = $entity->get(CANVAS_OVERRIDE_FIELD_NAME)->view([
    'label' => 'hidden',
    'type' => 'canvas_naive_render_sdc_tree',
    'settings' => [],
  ]);
}

/**
 * Implements hook_form_node_type_form_alter().
 *
 * Adds a "Canvas layout editing" checkbox to the content type form.
 */
function canvas_override_form_node_type_form_alter(array &$form, FormStateInterface $form_state): void {
  /** @var \Drupal\node\NodeTypeInterface $node_type */
  $node_type = $form_state->getFormObject()->getEntity();
  $is_enabled = (bool) $node_type->getThirdPartySetting('canvas_override', 'enabled', FALSE);

  $form['canvas_override'] = [
    '#type' => 'details',
    '#title' => t('Canvas layout'),
    '#group' => 'additional_settings',
  ];

  $form['canvas_override']['canvas_override_enabled'] = [
    '#type' => 'checkbox',
    '#title' => t('Enable per-node Canvas layout editing on the <em>full content</em> view mode'),
    '#description' => t('When enabled, each node of this type gets its own Canvas layout. A <strong>Canvas</strong> tab appears on every node, allowing editors to visually compose a unique page layout with Canvas components.'),
    '#default_value' => $is_enabled,
  ];

  // Store the old value so the submit handler can detect changes.
  $form['canvas_override']['canvas_override_was_enabled'] = [
    '#type' => 'value',
    '#value' => $is_enabled,
  ];

  $form['actions']['submit']['#submit'][] = 'canvas_override_node_type_form_submit';
}

/**
 * Submit handler: persists the Canvas setting and ensures the field exists.
 */
function canvas_override_node_type_form_submit(array &$form, FormStateInterface $form_state): void {
  /** @var \Drupal\node\NodeTypeInterface $node_type */
  $node_type = $form_state->getFormObject()->getEntity();
  $enabled = (bool) $form_state->getValue('canvas_override_enabled');
  $was_enabled = (bool) $form_state->getValue('canvas_override_was_enabled');

  $node_type->setThirdPartySetting('canvas_override', 'enabled', $enabled);
  $node_type->save();

  // When newly enabled, ensure a component_tree field and view display exist.
  if ($enabled && !$was_enabled) {
    _canvas_override_ensure_canvas_field($node_type->id());
  }
}

/**
 * Adds a component_tree field to the content type and configures the display.
 */
function _canvas_override_ensure_canvas_field(string $bundle): void {
  $field_name = CANVAS_OVERRIDE_FIELD_NAME;

  // Create field storage if it doesn't exist yet (shared across bundles).
  if (!FieldStorageConfig::loadByName('node', $field_name)) {
    FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'type' => 'component_tree',
      'settings' => [],
    ])->save();
  }

  // Create the field instance on this bundle if it doesn't exist.
  if (!FieldConfig::loadByName('node', $bundle, $field_name)) {
    FieldConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'bundle' => $bundle,
      'label' => 'Canvas Layout',
    ])->save();
  }

  // Configure the 'full' view display to render the canvas field.
  /** @var \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display */
  $display = \Drupal::service('entity_display.repository')
    ->getViewDisplay('node', $bundle, 'full');

  if (!$display->getComponent($field_name)) {
    $display->setComponent($field_name, [
      'label' => 'hidden',
      'type' => 'canvas_naive_render_sdc_tree',
      'weight' => -2,
    ])->save();
  }

  // Also configure the default view display.
  $default_display = \Drupal::service('entity_display.repository')
    ->getViewDisplay('node', $bundle, 'default');

  if (!$default_display->getComponent($field_name)) {
    $default_display->setComponent($field_name, [
      'label' => 'hidden',
      'type' => 'canvas_naive_render_sdc_tree',
      'weight' => -2,
    ])->save();
  }

  \Drupal::messenger()->addStatus(t('A Canvas layout field has been added to this content type. Each node will have its own Canvas layout editable from the <strong>Canvas</strong> tab.'));
}

/**
 * Implements hook_entity_presave() for node_type entities.
 *
 * Ensures the component_tree field exists whenever a node type is saved with
 * canvas_override enabled. This covers programmatic enabling (e.g. config
 * import, recipes) where the form submit handler is not triggered.
 */
function canvas_override_node_type_presave(NodeTypeInterface $node_type): void {
  if ($node_type->getThirdPartySetting('canvas_override', 'enabled', FALSE)) {
    _canvas_override_ensure_canvas_field($node_type->id());
  }
}

/**
 * Implements hook_entity_operation().
 *
 * Adds a "Canvas" operation to nodes whose type has Canvas enabled.
 */
function canvas_override_entity_operation(EntityInterface $entity): array {
  $operations = [];

  if ($entity->getEntityTypeId() !== 'node') {
    return $operations;
  }

  /** @var \Drupal\node\NodeInterface $entity */
  $node_type = \Drupal::entityTypeManager()
    ->getStorage('node_type')
    ->load($entity->bundle());

  if (!$node_type instanceof NodeTypeInterface) {
    return $operations;
  }

  if (!$node_type->getThirdPartySetting('canvas_override', 'enabled', FALSE)) {
    return $operations;
  }

  // Check node has the canvas field.
  if (!$entity->hasField(CANVAS_OVERRIDE_FIELD_NAME)) {
    return $operations;
  }

  $current_user = \Drupal::currentUser();
  if ($current_user->hasPermission('administer content templates')) {
    $operations['canvas'] = [
      'title' => t('Canvas'),
      'url' => Url::fromRoute('canvas_override.node.canvas', ['node' => $entity->id()]),
      'weight' => 50,
    ];
  }

  return $operations;
}

/**
 * Implements hook_entity_form_display_alter().
 *
 * Hides content-related fields from the per-entity Canvas editor's Page data
 * panel. When editors use the per-entity Canvas editor (not the ContentTemplate
 * editor), fields like body/content and featured image should not appear since
 * their content is composed directly in the Canvas layout.
 */
function canvas_override_entity_form_display_alter(EntityFormDisplayInterface $form_display, array $context): void {
  // Only act on canvas API routes (the Page data panel).
  $route_match = \Drupal::routeMatch();
  if (!\str_starts_with((string) $route_match->getRouteName(), 'canvas.api.')) {
    return;
  }

  // Only act on node entities.
  if ($form_display->getTargetEntityTypeId() !== 'node') {
    return;
  }

  $bundle = $form_display->getTargetBundle();

  // Only act on bundles with canvas_override enabled.
  $node_type = \Drupal::entityTypeManager()->getStorage('node_type')->load($bundle);
  if (!$node_type instanceof NodeTypeInterface) {
    return;
  }
  if (!$node_type->getThirdPartySetting('canvas_override', 'enabled', FALSE)) {
    return;
  }

  // Fields to hide from the per-entity Canvas editor's Page data panel.
  // These are fields whose content is composed in the Canvas layout itself.
  $fields_to_hide = [
    // Standard Drupal body field.
    'body',
    // Common content field names.
    'field_content',
    // Common image field names.
    'field_image',
    'field_featured_image',
    'field_media_image',
    // The canvas layout field itself (not useful in the Page data form).
    CANVAS_OVERRIDE_FIELD_NAME,
  ];

  foreach ($fields_to_hide as $field_name) {
    $form_display->removeComponent($field_name);
  }
}
