{
  "name": "canvas_override",
  "description": "Lets site builders enable per-content Canvas-based layout editing on the full content view mode for selected content types.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "engines": {
    "yarn": ">= 4.9.3",
    "node": ">= 20.0"
  },
  "keywords": [
    "Drupal",
    "Varbase",
    "Canvas",
    "Layout",
    "varbase-e2e",
    "acceptance-testing"
  ],
  "author": "Vardot",
  "scripts": {
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:js": "node ./node_modules/eslint/bin/eslint.js .",
    "lint:yaml": "node ./node_modules/eslint/bin/eslint.js --ext .yml .",
    "spellcheck": "cspell lint .",
    "test": "cucumber-js --config cucumber.js",
    "test:drupal": "cucumber-js --config cucumber.js",
    "test:drupalcms": "cucumber-js --config cucumber.drupalcms.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports"
  },
  "devDependencies": {
    "@vardot/varbase-e2e": "~2.0.1",
    "cspell": "^8.16.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jquery": "^1.5.1",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-yml": "^1.18.0",
    "glob": "11.0.0",
    "jsdom": "^26.1.0",
    "loadjs": "^4.3.0",
    "minimist": "^1.2.8",
    "mkdirp": "^3.0.1",
    "nightwatch": "^3.12.1",
    "prettier": "^3.5.3",
    "tabbable": "^6.2.0",
    "terser": "^5.39.0",
    "terser-webpack-plugin": "^5.3.14",
    "underscore": "~1.13.7",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1"
  },
  "browserslist": [
    "last 2 Chrome major versions",
    "last 2 Firefox major versions",
    "last 2 Safari major versions",
    "last 2 Edge major versions",
    "last 2 Opera versions",
    "last 2 iOS major versions",
    "last 1 ChromeAndroid version",
    "last 1 Samsung version",
    "Firefox ESR"
  ],
  "packageManager": "yarn@4.9.3",
  "_resolutions_note": "varbase-e2e floats @cucumber/cucumber '*' which resolves to v13 (needs Node 22); the resolution below pins the transitive cucumber to the 12.x line so the suite runs on Node 20.",
  "resolutions": {
    "@cucumber/cucumber": "12.9.0"
  }
}
